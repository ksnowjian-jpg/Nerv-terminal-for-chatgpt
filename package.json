{
  "name": "chatgpt-desktop-theme-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/run.mjs serve",
    "test": "vitest run",
    "test:ui": "playwright test",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "test:client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-client.ps1 -WaitForExit",
    "client": "node scripts/run.mjs client"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0",
    "zod": "^3.25.0"
  }
}
